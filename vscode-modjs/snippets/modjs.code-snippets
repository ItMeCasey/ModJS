    "description": "ServerEvents.recipes"
  },
  "ModJS shaped recipe": {
    "prefix": "modjs-shaped",
    "body": [
      "event.shaped('${1:minecraft:diamond}', [",
      "\t'${2:AAA}',",
      "\t'${3:A A}',",
      "\t'${4:AAA}'",
      "], { A: '${5:minecraft:coal}' });"
    ],
    "description": "event.shaped"
  },
  "ModJS shapeless recipe": {
    "prefix": "modjs-shapeless",
    "body": ["event.shapeless('${1:minecraft:diamond}', ['${2:minecraft:coal}', '${3:minecraft:coal}']);"],
    "description": "event.shapeless"
  },
